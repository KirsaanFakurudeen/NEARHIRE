rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Resumes: only the seeker who owns it can upload; authenticated users can read
    match /resumes/{seekerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == seekerId
        && request.resource.size < 5 * 1024 * 1024  // 5 MB max
        && request.resource.contentType == 'application/pdf';
    }
  }
}
